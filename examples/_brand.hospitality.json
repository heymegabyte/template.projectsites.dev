{
  "$schema": "https://schemas.designtokens.org/2025-10",
  "$description": "Hospitality preset — hotels / resorts / inns / lodges. DARK, aspirational 'stay-with-us' luxe: warm charcoal + champagne-gold accent, soft radii, deep warm shadows, refined Cormorant Garamond headings over Inter. Boutique hotels, resorts, B&Bs, guest houses map here (never retail 'free shipping').",

  "business": {
    "name":          { "$value": "The Wren House" },
    "shortName":     { "$value": "The Wren" },
    "tagline":       { "$value": "Stay a little longer" },
    "description":   { "$value": "An independent boutique hotel where thoughtful design, an unhurried pace, and genuine local hospitality turn a night away into a reason to return. Rooms that feel like a retreat, service that anticipates, and a neighborhood worth stepping into." },
    "url":           { "$value": "https://thewrenhouse.example" },
    "businessClass": { "$value": "hospitality" },
    "email":         { "$value": "stay@thewrenhouse.example" },
    "phone":         { "$value": "" },
    "address":       { "$value": "" },
    "hours":         { "$value": "" }
  },

  "color": {
    "brandHue":    { "$value": "40" },
    "brandChroma": { "$value": "0.05" },
    "primary":     { "$value": "oklch(0.56 0.07 45)" },
    "primaryHover":{ "$value": "oklch(0.50 0.07 45)" },
    "accent":      { "$value": "oklch(0.80 0.11 85)" },
    "accentHover": { "$value": "oklch(0.74 0.12 82)" },
    "background":  { "$value": "oklch(0.18 0.015 55)" },
    "surface":     { "$value": "oklch(0.23 0.018 55)" },
    "surfaceElevated":{ "$value": "oklch(0.28 0.02 55)" },
    "border":      { "$value": "oklch(0.37 0.02 55)" },
    "text":        { "$value": "oklch(0.96 0.008 85)" },
    "textMuted":   { "$value": "oklch(0.78 0.015 85)" },
    "textSubtle":  { "$value": "oklch(0.62 0.012 85)" },
    "success":     { "$value": "oklch(0.72 0.15 150)" },
    "warning":     { "$value": "oklch(0.80 0.15 80)" },
    "danger":      { "$value": "oklch(0.64 0.20 28)" },
    "info":        { "$value": "oklch(0.70 0.12 220)" }
  },

  "colorScheme": { "$value": "dark" },

  "themeStyle":  { "$value": "luxe", "$type": "string", "$description": "Visual personality preset (font/radius/shadow/motion + flourish). See template src/themePresets.ts." },

  "font": {
    "heading":   { "$value": "Cormorant Garamond" },
    "body":      { "$value": "Inter" },
    "mono":      { "$value": "JetBrains Mono" },
    "weights":   { "$value": [400,500,600,700] },
    "fluidScale":{ "$value": "clamp" }
  },

  "radius":  { "sm": { "$value": "0.375rem" }, "md": { "$value": "0.625rem" }, "lg": { "$value": "0.875rem" }, "xl": { "$value": "1.25rem" }, "2xl": { "$value": "1.75rem" }, "full": { "$value": "9999px" } },
  "spacing": { "0": { "$value": "0" }, "1": { "$value": "0.25rem" }, "2": { "$value": "0.5rem" }, "3": { "$value": "0.75rem" }, "4": { "$value": "1rem" }, "6": { "$value": "1.5rem" }, "8": { "$value": "2rem" }, "12": { "$value": "3rem" }, "16": { "$value": "4rem" }, "24": { "$value": "6rem" }, "32": { "$value": "8rem" } },
  "shadow":  { "sm": { "$value": "0 1px 2px 0 oklch(0 0 0 / 0.35)" }, "md": { "$value": "0 12px 30px -10px oklch(0 0 0 / 0.55), 0 3px 8px -4px oklch(0 0 0 / 0.40)" }, "lg": { "$value": "0 28px 60px -14px oklch(0 0 0 / 0.62), 0 6px 16px -6px oklch(0 0 0 / 0.45)" }, "glow": { "$value": "0 0 52px -10px oklch(0.80 0.11 85 / 0.45)" } },
  "motion":  { "easing": { "$value": "cubic-bezier(0.2, 0.7, 0.3, 1)" }, "duration": { "fast": { "$value": "140ms" }, "base": { "$value": "260ms" }, "slow": { "$value": "460ms" }, "scroll": { "$value": "1200ms" } } },
  "layout":  { "containerWide": { "$value": "82rem" }, "containerNormal": { "$value": "64rem" }, "containerProse": { "$value": "42rem" } },
  "social":  { "facebook": { "$value": "" }, "instagram": { "$value": "" }, "linkedin": { "$value": "" }, "twitter": { "$value": "" }, "youtube": { "$value": "" }, "tiktok": { "$value": "" }, "github": { "$value": "" } },

  "features": {
    "hero":         { "$value": true },
    "bento":        { "$value": true },
    "stats":        { "$value": true },
    "services":     { "$value": true },
    "process":      { "$value": false },
    "testimonials": { "$value": true },
    "logoCloud":    { "$value": false },
    "pricing":      { "$value": false },
    "faq":          { "$value": true },
    "blog":         { "$value": true },
    "team":         { "$value": false },
    "caseStudies":  { "$value": false },
    "newsletter":   { "$value": true },
    "cta":          { "$value": true }
  }
}
