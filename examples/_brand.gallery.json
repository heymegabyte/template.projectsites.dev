{
  "$schema": "https://schemas.designtokens.org/2025-10",
  "$description": "Gallery preset — art galleries / museums / exhibition spaces. DARK, stark editorial: near-monochrome charcoal so the ARTWORK carries the color, whisper-thin borders, minimal radii, restrained shadows, Space Grotesk headings over Inter. Galleries/museums/art dealers map here (never retail 'shop the collection / free shipping').",

  "business": {
    "name":          { "$value": "Meridian Gallery" },
    "shortName":     { "$value": "Meridian" },
    "tagline":       { "$value": "Where the work speaks" },
    "description":   { "$value": "A contemporary art gallery presenting a rotating program of exhibitions across painting, sculpture, and new media. We give the work room to breathe, and give collectors and the curious alike a considered place to encounter it." },
    "url":           { "$value": "https://meridiangallery.example" },
    "businessClass": { "$value": "gallery" },
    "email":         { "$value": "hello@meridiangallery.example" },
    "phone":         { "$value": "" },
    "address":       { "$value": "" },
    "hours":         { "$value": "" }
  },

  "color": {
    "brandHue":    { "$value": "60" },
    "brandChroma": { "$value": "0.01" },
    "primary":     { "$value": "oklch(0.72 0.03 70)" },
    "primaryHover":{ "$value": "oklch(0.80 0.03 70)" },
    "accent":      { "$value": "oklch(0.78 0.07 70)" },
    "accentHover": { "$value": "oklch(0.85 0.07 70)" },
    "background":  { "$value": "oklch(0.15 0.004 90)" },
    "surface":     { "$value": "oklch(0.19 0.005 90)" },
    "surfaceElevated":{ "$value": "oklch(0.24 0.006 90)" },
    "border":      { "$value": "oklch(0.34 0.006 90)" },
    "text":        { "$value": "oklch(0.97 0.003 90)" },
    "textMuted":   { "$value": "oklch(0.77 0.005 90)" },
    "textSubtle":  { "$value": "oklch(0.60 0.005 90)" },
    "success":     { "$value": "oklch(0.72 0.15 150)" },
    "warning":     { "$value": "oklch(0.80 0.15 80)" },
    "danger":      { "$value": "oklch(0.64 0.20 28)" },
    "info":        { "$value": "oklch(0.70 0.12 220)" }
  },

  "colorScheme": { "$value": "dark" },

  "themeStyle":  { "$value": "editorial", "$type": "string", "$description": "Visual personality preset (font/radius/shadow/motion + flourish). See template src/themePresets.ts." },

  "font": {
    "heading":   { "$value": "Space Grotesk" },
    "body":      { "$value": "Inter" },
    "mono":      { "$value": "JetBrains Mono" },
    "weights":   { "$value": [400,500,600,700] },
    "fluidScale":{ "$value": "clamp" }
  },

  "radius":  { "sm": { "$value": "0.125rem" }, "md": { "$value": "0.1875rem" }, "lg": { "$value": "0.25rem" }, "xl": { "$value": "0.375rem" }, "2xl": { "$value": "0.5rem" }, "full": { "$value": "9999px" } },
  "spacing": { "0": { "$value": "0" }, "1": { "$value": "0.25rem" }, "2": { "$value": "0.5rem" }, "3": { "$value": "0.75rem" }, "4": { "$value": "1rem" }, "6": { "$value": "1.5rem" }, "8": { "$value": "2rem" }, "12": { "$value": "3rem" }, "16": { "$value": "4rem" }, "24": { "$value": "6rem" }, "32": { "$value": "8rem" } },
  "shadow":  { "sm": { "$value": "0 1px 0 0 oklch(0 0 0 / 0.30)" }, "md": { "$value": "0 6px 18px -8px oklch(0 0 0 / 0.50)" }, "lg": { "$value": "0 18px 40px -12px oklch(0 0 0 / 0.58)" }, "glow": { "$value": "0 0 0 1px oklch(0.78 0.07 70 / 0.30)" } },
  "motion":  { "easing": { "$value": "cubic-bezier(0.22, 0.8, 0.28, 1)" }, "duration": { "fast": { "$value": "130ms" }, "base": { "$value": "240ms" }, "slow": { "$value": "440ms" }, "scroll": { "$value": "1150ms" } } },
  "layout":  { "containerWide": { "$value": "84rem" }, "containerNormal": { "$value": "66rem" }, "containerProse": { "$value": "42rem" } },
  "social":  { "facebook": { "$value": "" }, "instagram": { "$value": "" }, "linkedin": { "$value": "" }, "twitter": { "$value": "" }, "youtube": { "$value": "" }, "tiktok": { "$value": "" }, "github": { "$value": "" } },

  "features": {
    "hero":         { "$value": true },
    "bento":        { "$value": true },
    "stats":        { "$value": false },
    "services":     { "$value": false },
    "process":      { "$value": false },
    "testimonials": { "$value": true },
    "logoCloud":    { "$value": false },
    "pricing":      { "$value": false },
    "faq":          { "$value": true },
    "blog":         { "$value": true },
    "team":         { "$value": false },
    "caseStudies":  { "$value": false },
    "newsletter":   { "$value": true },
    "cta":          { "$value": true }
  }
}
